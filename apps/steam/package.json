{
  "name": "meitner-analytical",
  "version": "0.1.0",
  "private": true,
  "description": "Steam edition: identify unknown samples from simulated spectra.",
  "main": "main.js",
  "scripts": {
    "stage": "node scripts/stage.js",
    "start": "npm run stage && electron .",
    "dist": "npm run stage && electron-builder --win --dir"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.meitner",
    "productName": "Meitner Analytical",
    "files": ["main.js", "preload.js", "stage/**"],
    "asarUnpack": ["node_modules/steamworks.js/**"]
  }
}
